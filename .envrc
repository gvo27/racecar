# Loads the host dev tools (.venv from uv.lock) when you cd into the repo. Usage: direnv allow (one time per machine).
# Notes: .claude/rules/dependencies.md
# After a change to this file, every machine must run direnv allow again.
if [ ! -d .venv ]; then
  echo "direnv: .venv does not exist. Run: make dev-setup" >&2
fi
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin
