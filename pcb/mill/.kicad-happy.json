// kicad-happy project config of the mill board (plugin ref v2.3.2). Read by the kicad, emc and spice analyzers
// (make pcb-gate BOARD=mill, CI .github/workflows/pcb.yml). Suppressions only for verified false positives and
// owner decisions. Each reason names its evidence. Suppressed findings stay in the reports with the reason.
{
  "version": 1,
  "project": {
    "name": "RC Car Power Distribution Board, mill prototype (rev3 draft)"
  },
  "design_intent": {
    "product_class": "prototype",
    "ipc_class": 2,
    "target_market": "hobby"
  },
  "suppressions": [
    {
      "rule_id": "PU-001",
      "components": ["U1"],
      "reason": "False positive: the ESP32 input pull-up serves U1 PG (docs/pcb/review/README.md, PU-001 row; docs/pcb/power_board_plan.md)"
    },
    {
      "rule_id": "PU-001",
      "components": ["U3"],
      "reason": "False positive: U3 EN is tied to its input LDO_IN, as the AP2112 datasheet allows (docs/pcb/review/README.md, PU-001 row)"
    },
    {
      "rule_id": "GP-004",
      "nets": ["GND"],
      "reason": "Owner decision 2026-11-17: pours keep a 2.0 mm copper gap for the lab mill (zone_clearance), so the GND fill ratio is low by design (docs/techctcarvera/review/README.md)"
    }
  ]
}
