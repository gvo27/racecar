# U1: Pololu D36V50F5, 2.54 mm pin pitch, 0.64 mm between two pads. The VBAT necks are as wide as the pads, so zone copper is 0.64 mm from the next pad
(rule U1_fine
	(condition "A.Type == 'Pad' && A.Reference == 'U1' && B.Type != 'Track' && B.Type != 'Via'")
	(constraint clearance (min 0.64mm))
)
