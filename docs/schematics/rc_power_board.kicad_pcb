	(footprint "rc_power:Pololu_D36V50Fx"
		(layer "F.Cu")
		(uuid "4e31b24b-6a83-4e8f-a366-269d3a4d89b4")
		(at 74.35 136.11 90)
		(descr "Pololu D36V50F5 / D36V50Fx step-down module, 25.4 x 25.4 mm, 12 through-holes in 2 rows of 6 on a 0.1 inch grid. Top view, origin = pad 1 (inner row), pin edge on the right, body on the inner-row side (-X). Pads: 1 PG, 2 EN, 3-4 VRP, 5-6 VIN, 7-10 GND, 11-12 VOUT (odd = inner row). Mounting holes (2.18 mm) are drawn on F.Fab only: the module is held by its header. Parts stand 6.1 mm above the module PCB and 1.8 mm below it. Source: docs/datasheets/pololu_d36v50fx_dimensions.pdf, docs/datasheets/regulator_pololu_d36v50f5.md")
		(tags "Pololu D36V50F5 D36V50Fx regulator module THT")
		(property "Reference" "U2"
			(at -9 5 90)
