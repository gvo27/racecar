# copy to .env (gitignored): cp .env.example .env
TZ=UTC                      # container timezone, IANA name (e.g. Europe/Berlin)
PLATFORM=pi5                # selects tuning.toml [platform.<name>] (phase 2)
TS_DOMAIN=                  # tailnet domain, e.g. <tailnet>.ts.net; used in [models].base_url
ADMIN_TS_HOST=              # Tailscale hostname of the admin laptop (admin-link failsafe, later)
BACKUP_DEST=                # recorder backup destination, e.g. rclone remote:path (phase 3)
